# =============================================================================
# TheShippingHack Backend — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env with secrets.
# =============================================================================

NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# URLs used for redirects, emails, CORS
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# ─── Database (MySQL) ────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=shipping_hack
DB_USER=root
DB_PASSWORD=

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=
REDIS_TLS=false

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=
SECRET_KEY=

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Braintree ────────────────────────────────────────────────────────────────
BRAINTREE_ENVIRONMENT=sandbox
MERCHANT_ID=
Public_Key=
Private_Key=

# ─── PayPal ───────────────────────────────────────────────────────────────────
PAYPAL_ENVIRONMENT=sandbox
paypalClientId=
paypalClientSecret=

# ─── Shopify ──────────────────────────────────────────────────────────────────
SHOP_NAME=
SHOPIFY_API_KEY=
SHOPIFY_APP_PASSWORD=

# ─── Email (Nodemailer) ──────────────────────────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=

# ─── FedEx (future) ──────────────────────────────────────────────────────────
FEDEX_ENVIRONMENT=sandbox
client_id=
client_secret=
client_id_track=
client_secret_track=

# ─── Firebase Admin (FCM push + Realtime DB) ─────────────────────────────────
# Provide the FULL service-account JSON as a single-line string (production:
# loaded from SSM SecureString). If unset, the app falls back to ./firebase.json
# for LOCAL DEV ONLY. firebase.json must never be committed or deployed.
FIREBASE_SERVICE_ACCOUNT=
# Optional base64-encoded alternative to the above (whichever is easier to store):
FIREBASE_SERVICE_ACCOUNT_BASE64=

# ─── File storage / uploads ──────────────────────────────────────────────────
# STORAGE_DRIVER: "local" (files under ./Public, default) or "s3".
STORAGE_DRIVER=local
# Secret used to sign local expiring file URLs. Defaults to JWT_ACCESS_SECRET.
FILE_URL_SIGNING_SECRET=
# How long signed/presigned file URLs remain valid (seconds).
SIGNED_URL_TTL_SECONDS=300

# ─── Swagger ──────────────────────────────────────────────────────────────────
Test_URL=
Prod_Url=

# ─── AWS / S3 ────────────────────────────────────────────────────────────────
# On EC2, credentials come from the instance IAM role — do NOT set access keys.
AWS_REGION=us-east-1
S3_BUCKET=
S3_REGION=us-east-1
# Optional public base URL for non-sensitive assets (e.g. a CDN or bucket URL).
S3_PUBLIC_BASE_URL=
# Set to "true" only if non-sensitive objects should be uploaded public-read.
S3_PUBLIC_ACL=false
